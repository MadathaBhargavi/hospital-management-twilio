{
  "name": "hospital-management-app",
  "version": "1.0.0",
  "description": "Professional Hospital Management & Patient Communication Web App with Twilio SMS/OTP Integration",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/src/server.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/src/server.js",
    "test-db": "node -e \"require('./server/src/config/database.js')\""
  },
  "keywords": ["hospital", "healthcare", "twilio", "sms", "appointments", "react", "express", "sqlite"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "twilio": "^5.12.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
